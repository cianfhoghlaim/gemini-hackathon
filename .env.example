# ============================================================================
# gemini-hackathon environment variables
# Copy to .env (gitignored) and fill in real values.
# All API keys are loaded via the canonical Infisical+mise+Locket three-way
# contract in production (see .agents/skills/secrets-management/SKILL.md).
# ============================================================================

# ----- MiniMax (primary LLM provider) ---------------------------------------
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=minimax.io/MiniMax-M3

# ----- Unsloth (local Ollama-compatible inference) --------------------------
# Serve unsloth/gemma-4-26B-A4B-it-GGUF via ollama or llama.cpp on port 11434
# then point this at http://localhost:11434/v1
UNSLOTH_BASE_URL=http://localhost:11434/v1
UNSLOTH_MODEL=unsloth/gemma-4-26B-A4B-it-GGUF
UNSLOTH_API_KEY=ollama  # ollama accepts any value when AUTH is disabled

# ----- Vertex AI (Gemini 3.5 Flash fallback) ---------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex-ai-credentials.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-3.5-flash

# ----- MotherDuck (managed DuckLake) -----------------------------------------
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=cianfhoghlaim

# ----- Letta (agent memory backend) ------------------------------------------
LETTA_API_KEY=
LETTA_BASE_URL=https://api.letta.com

# ----- Langfuse (observability — traces, costs, RAG eval) ---------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ----- Firecrawl (web search + scrape for ChangeDetection) --------------------
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ----- App-level toggles -----------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DUCKDB_PATH=./data/gemini.duckdb
BAML_OUTPUT_DIR=./baml_client