# ============================================================================
# gemini-hackathon web env vars (Firebase + GCP-native)
# Copy to .env (gitignored) and fill in real values.
# ============================================================================

# ----- Firebase project init ---------------------------------------------------
VITE_FIREBASE_PROJECT_ID=gemini-hackathon-prod
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gemini-hackathon-prod.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=gemini-hackathon-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----- Firebase App Check (reCAPTCHA v3 site key) -----------------------------
# Get from https://console.cloud.google.com/security/app-check
# Use the dev key (6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXdiaZOnRk) for local development.
VITE_RECAPTCHA_SITE_KEY=

# ----- Cloud Functions for Firebase (Gen2) base URL -----------------------
# Production: https://europe-west1-${PROJECT_ID}.cloudfunctions.net
# Local emulator: http://127.0.0.1:5001/${PROJECT_ID}/europe-west1
VITE_FIREBASE_FUNCTIONS_URL=
VITE_FIREBASE_FUNCTIONS_ORIGIN=

# ----- Google Stitch (the design system push) -------------------------------
# Get your key at https://stitch.withgoogle.com (after creating the project)
# The key is also the Stitch MCP server URL embed key.
VITE_STITCH_API_KEY=
VITE_STITCH_PROJECT_ID=

# ----- Optional (the prior phases) --------------------------------------------
# Tier 2 — Gemma 4 (Unsloth Studio, local)
VITE_UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
VITE_UNSLOTH_API_KEY=

# LLM router
VITE_GEMINI_BACKEND=vertex # vertex | aistudio
VITE_GEMINI_MODEL=gemini-3.5-flash

# Observability
VITE_LANGFUSE_PUBLIC_KEY=
VITE_LANGFUSE_SECRET_KEY=
VITE_LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: enable the Firebase Local Emulator Suite in dev
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1