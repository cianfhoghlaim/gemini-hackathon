# ============================================================================
# gemini_hackathon environment variables
# Copy to .env (gitignored) and fill in real values.
# In production, all secrets are loaded via Google Cloud Secret Manager
# (project: agentic-hackathon-august-26) using ADC at process start.
# Set ADK_LOAD_SECRETS=1 to trigger the loader at gemini_hackathon import time.
# Set ADK_LOCAL_SECRETS=1 to fall back to this .env file (no GSM needed).
# The catalogue of GSM IDs lives at secrets.yaml (committed).
# See: scripts/seed_gsm.py + scripts/audit_gsm.py
# ============================================================================

# ----- Model profile (gates which registry entries are exposed) --------------
# Values:
#   hackathon (default) — Tier 1 = Gemini 3.5, Tier 2 = Gemma 4 via Unsloth.
#                         This is the ONLY profile docs/UI/submission reference.
#   dev                 — Adds minimax-m3 and the wider Unsloth set for harness
#                         comparisons. Hackathon profile must NOT depend on it.
MODEL_PROFILE=hackathon

# ============================================================================
# Tier 1 — Gemini 3.5 Flash (hackathon primary)
# ============================================================================
# GEMINI_BACKEND selects the Gemini backend at runtime:
#   vertex    — Google Cloud Vertex AI (default; ADC, promotes Google Cloud usage)
#   aistudio  — Google AI Studio (API key; convenient fallback)
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# AI Studio only used when GEMINI_BACKEND=aistudio
GEMINI_API_KEY=

# ============================================================================
# Tier 2 — Gemma 4 26B-A4B via Unsloth Studio (hackathon fallback)
# ============================================================================
# Unsloth Studio is a host process at :8888 (per
# cianfhoghlaim/bonneagar/stacks/unsloth-serve/README.md). From Docker it is
# reached via host.docker.internal; on GCE via the VM's internal IP.
# Three deployment matrices:
#   Local host dev      : http://127.0.0.1:8888/v1
#   Docker dev (compose): http://host.docker.internal:8888/v1
#   GCE hackathon VM    : http://UNSLOTH_VM_INTERNAL_IP:8888/v1
UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
UNSLOTH_API_KEY=
# Infisical path: infisical://dev-baile/unsloth/api_key

# ============================================================================
# Dev profile only — minimax-m3 + wider Unsloth Studio text set
# ============================================================================
# These are only loaded when MODEL_PROFILE=dev. The hackathon profile does
# not depend on them; production-submission code paths must not reference them.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=minimax-m3

# ============================================================================
# OCR / VLM (shared llama-swap service)
# ============================================================================
LLAMA_SWAP_BASE_URL=http://127.0.0.1:8080/v1
LLAMASWAP_API_KEY=not-required
LLAMA_MODELS_DIR=../cianfhoghlaim/stedding/models/llama

# ============================================================================
# Image generation (Phase 8 — ComfyUI + InvokeAI + Unsloth Studio)
# ============================================================================
INVOKEAI_BASE_URL=http://127.0.0.1:9090/v1
INVOKEAI_API_KEY=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=

# ============================================================================
# Data plane
# ============================================================================
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=cianfhoghlaim
DUCKDB_PATH=./data/gemini.duckdb

# ============================================================================
# Memory + observability
# ============================================================================
LETTA_API_KEY=
LETTA_BASE_URL=https://api.letta.com

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================================
# Web search + scrape (ChangeDetection feeds)
# ============================================================================
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ============================================================================
# App-level toggles
# ============================================================================
APP_ENV=development
LOG_LEVEL=INFO
BAML_OUTPUT_DIR=./baml_client

# ============================================================================
# Data plane — embeddings + vector targets (Phase 2 GCP-first + offline fallback)
# ============================================================================
# EMBED_BACKEND selects the embedder. Values:
#   vertex              — Gemini embedding-001 via Vertex AI (1536-d, default)
#   sentence_transformers — BAAI/bge-m3 local (1024-d, offline-safe)
EMBED_BACKEND=sentence_transformers
GEMINI_HACKATHON_EMBED_MODEL=BAAI/bge-m3

# VECTOR_BACKEND selects the vector store. Values:
#   firestore — Firestore FindNearest (default; works with the GCP deploy)
#   vertex    — Vertex AI Vector Search (paid; ~$48/mo minimum)
VECTOR_BACKEND=firestore

# LanceDB offline fallback (only read when VECTOR_BACKEND=lancedb or EMBED_BACKEND=sentence_transformers)
LANCEDB_URI=./data/lancedb/gemini_hackathon.lance
GEMINI_HACKATHON_LANCEDB_URL=./data/lancedb/gemini_hackathon.lance

# DLT 4-backend destination (one of: duckdb_local | bigquery_biep | ducklake_gemini_hackathon | motherduck_gemini_hackathon)
DLT_DESTINATION=duckdb_local
GCS_RAW_BUCKET=

# ============================================================================
# Secrets loader (per docs/GSM_README.md + secrets.yaml)
# ============================================================================
# ADK_LOAD_SECRETS=1 to load from Google Secret Manager at gemini_hackathon import time.
# ADK_LOCAL_SECRETS=1 to fall back to this .env file (no GSM needed — default for dev).
ADK_LOAD_SECRETS=0
ADK_LOCAL_SECRETS=1

# ============================================================================
# OTEL — the canonical Stackdriver AI Agent ADK 6-env-var set
# (per gemini_hackathon_backend/tests/test_gcp_observability_e2e.py)
# ============================================================================
OTEL_SERVICE_NAME=gemini-hackathon-adk
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# ============================================================================
# Web SPA — Vite env vars (web/src/routes/__root.tsx + web/src/routes/agents.tsx)
# ============================================================================
VITE_FIREBASE_PROJECT_ID=gemini-hackathon-prod
VITE_ADK_RUNTIME_URL=http://localhost:8000
VITE_COPILOTKIT_PUBLIC_LICENSE_KEY=

# ============================================================================
# Firestore + GCP auth
# ============================================================================
FIRESTORE_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
JOURNEY_FIRESTORE_DATABASE=(default)

# ============================================================================
# Memory (markdown-based local fallback — per gemini_hackathon/memory/markdown.py)
# ============================================================================
GH_MEMORY_DIR=
GH_MEMORY_USER=userx

# Identity JWT (per gemini_hackathon/agents/fleet/fleet_identity.py)
IDENTITY_JWT_SECRET=

# ============================================================================
# HuggingFace Spaces (per gemini_hackathon_gradio/oideachais_pdf_review/app.py)
# ============================================================================
SPACE_ID=
SUGGESTION_MODEL=
EXPLANATION_MODEL=
SUGGESTION_DURATION=60
EXPLANATION_DURATION=120
HF_TOKEN=

# ============================================================================
# GCP Cloud Run deploy (per gemini_hackathon_gradio/editorial_studio/deploy.py)
# ============================================================================
GH_GCP_PROJECT_ID=agentic-hackathon-august-26
GH_GCP_REGION=europe-west1
GH_SERVICE_NAME=gemini-hackathon-editorial-studio
GCP_PROJECT_ID=agentic-hackathon-august-26

# ============================================================================
# BAML codegen + test (per .agents/skills/baml/SKILL.md)
# ============================================================================
BAML_TEST_MODE=true
BAML_LANG=python,typescript

# ============================================================================
# Notebook export — marimo WASM (per scripts/convert_marimo_to_ipynb.sh)
# ============================================================================
MARIMO_NOTEBOOK_DIR=./notebooks

# ----- Build / deploy -------------------------------------------------------
# Updated 2026-08-31 (Phase 6): these were referenced by code but missing.
COMMIT_SHA=
DEPLOYED_AGENT_ENGINE_ID=
GEMMA_VERTEX_ENDPOINT_ID=
GCP_PROJECT=agentic-hackathon-august-26

# ----- Document AI (OCR path 1 — Path 1 of the 4-path ensemble) -----------
# Updated 2026-08-31 (Phase 6): Document AI is optional; gemini_hackathon falls
# back to gemini_vision / gemma4_vertex / pypdfium2 text layer when unset.
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=

# ----- Gemini GenAI SDK + ADK observability -----
# Updated 2026-08-31 (Phase 6): the modern Google GenAI SDK uses
# GOOGLE_GENAI_USE_VERTEXAI=1 to switch from AI Studio to Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=true
# Updated 2026-08-31 (Phase 6): the GenAI telemetry log sub-path prefix.
GENAI_TELEMETRY_PATH=completions

# ----- Memory service (per gemini_hackathon/memory/*) -----
# Updated 2026-08-31 (Phase 6): the memory namespace suffix (was hard-coded).
MEMORY_NAMESPACE=default

# ----- Stitch (per functions/src/stitch.ts) -----
# Updated 2026-08-31 (Phase 6): Stitch API key + project id (was missing).
STITCH_API_KEY=
STITCH_PROJECT_ID=gemini-hackathon

# ============================================================================
# Journey codelab (per docs/JOURNEY.md)
# ============================================================================
# Updated 2026-08-31 (Phase 6): these were consumed by journey/sourcing/*,
# journey/journey_orchestrator/*, journey/scripts/admin_create_event.py, and
# journey/sourcing/copilot/* but missing from .env.example.
JOURNEY_EVENT_CODE=biep-demo-2026
JOURNEY_FIRESTORE_DATABASE=(default)
JOURNEY_GCS_RAW_BUCKET=gemini-hackathon-journey-raw
JOURNEY_GCS_DERIVED_BUCKET=gemini-hackathon-journey-derived
JOURNEY_LOCAL_CACHE_DIR=./data/journey/cache
JOURNEY_CACHE_DISABLE_GCS=false
JOURNEY_COPILOT_MODEL=gemini-3.5-flash
JOURNEY_SESSION_DB_URL=sqlite:///./data/journey/sessions.db
JOURNEY_DEFAULT_SUBNATION=ireland
JOURNEY_DEFAULT_LEARNER_ID=biep-demo-learner
JOURNEY_DEFAULT_SUBJECT=chemistry_lc
JOURNEY_MAX_PARTICIPANTS=30
JOURNEY_ADMIN_EMAIL=journey-admin@example.com

# ============================================================================
# ADK observability (per docs/STACKDRIVER_AI_AGENT_ADK_INTEGRATION.md)
# ============================================================================
# Updated 2026-08-31 (Phase 6): the OTEL SDK exports span batches + logs to
# Stackdriver. The first batch hits
#   gs://<LOGS_BUCKET_NAME>/otel/{OTEL_RESOURCE_ATTRIBUTES service.name}/
# and the GenAI completion hooks upload to
#   {OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH}/<trace>.
LOGS_BUCKET_NAME=gemini-hackathon-otel-logs
OTEL_RESOURCE_ATTRIBUTES=service.namespace=gemini-hackathon,deployment.environment=hackathon
OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=gen_ai.content_upload_hook
OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://gemini-hackathon-otel-logs/genai-uploads
OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=json
MLFLOW_TRACKING_URI=http://localhost:5000
