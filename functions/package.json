{
  "name": "functions",
  "version": "1.0.0",
  "description": "gemini-hackathon Cloud Functions for Firebase (Gen2) — the 3 server routes + 1 chat streaming + 1 Stitch sync",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0",
    "@google-cloud/logging": "^11.2.0",
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^5.1.0",
    "@google-cloud/storage": "^7.14.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/instrumentation-http": "^0.55.0",
    "@opentelemetry/instrumentation-vertexai": "^0.4.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "cors": "^2.8.5",
    "google-auth-library": "^9.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "private": true
}