{
  "mcpServers": {
    "dlt-workspace-mcp": {
      "command": "uv",
      "args": ["run", "dlthub", "ai", "mcp", "--stdio"]
    },
    "firecrawl": {
      "command": "bunx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "crawl4ai": {
      "serverUrl": "https://crawl4ai-mcp.cianfhoghlaim.ie/sse"
    },
    "infisical": {
      "command": "bunx",
      "args": ["-y", "@infisical/mcp"],
      "env": {
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "${INFISICAL_CLIENT_ID}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "${INFISICAL_SECRET}",
        "INFISICAL_HOST_URL": "http://localhost:8081",
        "INFISICAL_PROJECT_ID": "${INFISICAL_PROJECT_ID}"
      }
    },
    "motherduck": {
      "command": "uvx",
      "args": ["mcp-server-motherduck", "--db-path", ":memory:", "--read-write", "--allow-switch-databases"],
      "env": {
        "MOTHERDUCK_TOKEN": "infisical://dev-baile/motherduck/token"
      }
    },
    "chrome": {
      "command": "bunx",
      "args": ["-y", "chrome-devtools-mcp"]
    },
    "cocoindex-code": {
      "command": "ccc",
      "args": ["mcp"]
    },
    "cognee": {
      "command": "uvx",
      "args": ["cognee-mcp"],
      "env": {
        "COGNEE_API_URL": "http://localhost:8100",
        "COGNEE_API_KEY": "infisical://dev-baile/cognee/api_key",
        "LLM_API_KEY": "${DEEPSEEK_API_KEY}"
      }
    },
    "graphiti": {
      "command": "uv",
      "args": ["run", "python", "-m", "graphiti_core.mcp"],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "devpassword"
      }
    },
    "langfuse": {
      "command": "bunx",
      "args": ["-y", "@langfuse/mcp"],
      "env": {
        "LANGFUSE_PUBLIC_KEY": "infisical://dev-baile/langfuse/public_key",
        "LANGFUSE_SECRET_KEY": "infisical://dev-baile/langfuse/secret_key",
        "LANGFUSE_HOST": "http://localhost:3000"
      }
    },
    "huggingface": {
      "serverUrl": "https://huggingface.co/mcp?login"
    },
    "design-system": {
      "command": "uv",
      "args": ["run", "python", "web/apps/cianfhoghlaim-leaving-cert/apps/web/packages/mcp/design-system-server.py", "--stdio"]
    }
  }
}
