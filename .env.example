# ============================================================================
# gemini_hackathon environment variables
# Copy to .env (gitignored) and fill in real values.
# In production, all secrets are loaded via Google Cloud Secret Manager
# (project: agentic-hackathon-august-26) using ADC at process start.
# Set ADK_LOAD_SECRETS=1 to trigger the loader at gemini_hackathon import time.
# Set ADK_LOCAL_SECRETS=1 to fall back to this .env file (no GSM needed).
# The catalogue of GSM IDs lives at secrets.yaml (committed).
# See: scripts/seed_gsm.py + scripts/audit_gsm.py
# ============================================================================

# ----- Model profile (gates which registry entries are exposed) --------------
# Values:
#   hackathon (default) — Tier 1 = Gemini 3.5, Tier 2 = Gemma 4 via Unsloth.
#                         This is the ONLY profile docs/UI/submission reference.
#   dev                 — Adds minimax-m3 and the wider Unsloth set for harness
#                         comparisons. Hackathon profile must NOT depend on it.
MODEL_PROFILE=hackathon

# ============================================================================
# Tier 1 — Gemini 3.5 Flash (hackathon primary)
# ============================================================================
# GEMINI_BACKEND selects the Gemini backend at runtime:
#   vertex    — Google Cloud Vertex AI (default; ADC, promotes Google Cloud usage)
#   aistudio  — Google AI Studio (API key; convenient fallback)
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# AI Studio only used when GEMINI_BACKEND=aistudio
GEMINI_API_KEY=

# ============================================================================
# Tier 2 — Gemma 4 26B-A4B via Unsloth Studio (hackathon fallback)
# ============================================================================
# Unsloth Studio is a host process at :8888 (per
# cianfhoghlaim/bonneagar/stacks/unsloth-serve/README.md). From Docker it is
# reached via host.docker.internal; on GCE via the VM's internal IP.
# Three deployment matrices:
#   Local host dev      : http://127.0.0.1:8888/v1
#   Docker dev (compose): http://host.docker.internal:8888/v1
#   GCE hackathon VM    : http://UNSLOTH_VM_INTERNAL_IP:8888/v1
UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
UNSLOTH_API_KEY=
# Infisical path: infisical://dev-baile/unsloth/api_key

# ============================================================================
# Dev profile only — minimax-m3 + wider Unsloth Studio text set
# ============================================================================
# These are only loaded when MODEL_PROFILE=dev. The hackathon profile does
# not depend on them; production-submission code paths must not reference them.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=minimax-m3

# ============================================================================
# OCR / VLM (shared llama-swap service)
# ============================================================================
LLAMA_SWAP_BASE_URL=http://127.0.0.1:8080/v1
LLAMASWAP_API_KEY=not-required
LLAMA_MODELS_DIR=../cianfhoghlaim/stedding/models/llama

# ============================================================================
# Image generation (Phase 8 — ComfyUI + InvokeAI + Unsloth Studio)
# ============================================================================
INVOKEAI_BASE_URL=http://127.0.0.1:9090/v1
INVOKEAI_API_KEY=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=

# ============================================================================
# Data plane
# ============================================================================
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=cianfhoghlaim
DUCKDB_PATH=./data/gemini.duckdb

# ============================================================================
# Memory + observability
# ============================================================================
LETTA_API_KEY=
LETTA_BASE_URL=https://api.letta.com

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================================
# Web search + scrape (ChangeDetection feeds)
# ============================================================================
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ============================================================================
# App-level toggles
# ============================================================================
APP_ENV=development
LOG_LEVEL=INFO
BAML_OUTPUT_DIR=./baml_client
